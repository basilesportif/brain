# Copy this file to .env inside the private Brain workspace and fill values there.
# Never commit .env or secret-bearing workspace files to the Brain monorepo.

# GitHub/Composio
COMPOSIO_API_KEY=
# Optional local/mock Composio-compatible base URL for tests; leave empty for production.
COMPOSIO_BASE_URL=
GH_TOKEN=

# ProtonMail Bridge (password is generated by Bridge, not your Proton account password)
PROTONMAIL_BRIDGE_USER=
PROTONMAIL_BRIDGE_PASSWORD=

# WHOOP OAuth
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8787/callback

# Mercury / Plaid finance integrations
MERCURY_API_TOKEN=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional private email noise filters (comma-separated). Keep personal senders here, not in repo code.
ASSISTANT_EMAIL_NOISE_SENDERS=
ASSISTANT_GMAIL_QUERY_EXCLUDES=

# Optional one-off calendar utility target
FOOTBALL_CALENDAR_ID=

# Optional transcription / provider helpers used by legacy scripts
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
