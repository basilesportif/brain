{
  "name": "@brain/web",
  "version": "0.0.0",
  "private": true,
  "description": "Durable web shell and generated static page publisher primitives for Brain.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "test": "node --test dist/**/*.test.js",
    "publish:page": "node dist/publish-page.js",
    "prune:pages": "node dist/prune-pages.js"
  },
  "bin": {
    "brain-web-publish-page": "./dist/publish-page.js",
    "brain-web-prune-pages": "./dist/prune-pages.js"
  }
}
