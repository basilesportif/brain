# User-owned/private assistant state boundaries. Keep only explanatory READMEs.
workspace/*
!workspace/README.md
private/*
!private/README.md
data/*
!data/README.md

# Local controller/agent registry state is machine-specific and may contain
# private paths, hosts, or workspace metadata. Keep public repo guidance in
# AGENTS.md/CLAUDE.md and docs/ instead.
.claude/repo-registry/

# OS/editor noise
.DS_Store
.idea/
.vscode/
